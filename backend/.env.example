DATABASE_URL=postgresql://user:password@localhost:5432/nextpath
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET=your-jwt-secret-here-change-in-production
NEXT_PUBLIC_API_URL=http://localhost:3000

# Opportunity provider (RapidAPI "Internships API") — powers Jobs & Internships
# recommendations. Two endpoints on this one product: Career Site API
# (internships) and Job Board API (jobs).
# NOTE: RapidAPI plans for opportunity-data providers commonly enforce small
# monthly request quotas. Check your quota at https://rapidapi.com/developer/billing
# before assuming the integration is broken — a 429 means the plan is spent,
# not a bug. Raise OPPORTUNITY_CACHE_TTL_SECONDS if you're on a low-quota plan.
OPPORTUNITY_RAPIDAPI_KEY=
OPPORTUNITY_RAPIDAPI_HOST=internships-api.p.rapidapi.com
OPPORTUNITY_CACHE_TTL_SECONDS=900
# How long (seconds) to stop calling the provider after a 429, so a spent
# quota fails fast instead of being hit on every request.
OPPORTUNITY_QUOTA_BACKOFF_SECONDS=3600

# Opportunity match scoring weights (deterministic skill score vs AI contextual score)
OPPORTUNITY_DETERMINISTIC_WEIGHT=0.6
OPPORTUNITY_AI_WEIGHT=0.4
OPPORTUNITY_AI_TOP_N=5
# This provider returns no explicit skills field, so every posting falls back
# to a Groq extraction call. Results are cached per posting, but this caps
# how many *new* extractions one request will pay for.
OPPORTUNITY_MAX_SKILL_EXTRACTIONS=20
